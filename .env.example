# ========================================================
# Cozy Next.js 3D Agent Workspace - Environment Config
# ========================================================
#
# Petunjuk Penggunaan:
# 1. Untuk PEMAKAIAN LOKAL:
#    - File ini TIDAK WAJIB diisi.
#    - Endpoint /api/events otomatis terbuka tanpa token untuk koneksi localhost.
#
# 2. Untuk DEPLOYMENT KE HOSTING (Vercel, Railway, VPS, dll):
#    - Salin file ini menjadi .env.local:
#      copy .env.example .env.local
#    - Atau isi langsung di dashboard hosting (Environment Variables).
#

# Token rahasia untuk memvalidasi telemetri dari OMP extension.
# Jika variabel ini diisi, request POST /api/events wajib menyertakan header:
# Authorization: Bearer <VO_API_TOKEN>
# Token yang sama harus dipasang di: ~/.omp/agent/extensions/virtual-office.ts
VO_API_TOKEN=your_secret_token_here_12345

# Port server (opsional, default Next.js adalah 3000)
PORT=3000
